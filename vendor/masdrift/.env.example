# Copy this file to .env and replace placeholders locally.
# Never commit .env or real credentials.

# Default worker provider
MAS_LLM_PROVIDER=openai
OPENAI_API_KEY=replace-me
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://relay.example.com/v1
# OPENAI_REASONING_EFFORT=low

# Optional comma-separated keys or endpoint pool for concurrent runs
# OPENAI_API_KEYS=replace-me-1,replace-me-2
# MAS_LLM_POOL=[{"provider":"openai","api_key":"replace-me","base_url":"https://relay.example.com/v1","model":"gpt-4o-mini"}]

# Optional role-specific model profiles
# MAS_LEAD_LLM_PROVIDER=openai
# MAS_LEAD_LLM_MODEL=gpt-5.6-sol
# MAS_LEAD_LLM_API_KEYS=replace-me
# MAS_LEAD_LLM_BASE_URL=https://relay.example.com/v1
# MAS_LEAD_LLM_REASONING_EFFORT=low
# MAS_DELEGATE_LLM_PROVIDER=openai
# MAS_DELEGATE_LLM_MODEL=gpt-5.4-nano
# MAS_DELEGATE_LLM_API_KEYS=replace-me
# MAS_DELEGATE_LLM_BASE_URL=https://relay.example.com/v1
# MAS_DELEGATE_LLM_REASONING_EFFORT=low

# DeepSeek worker alternative
# MAS_LLM_PROVIDER=deepseek
# DEEPSEEK_API_KEY=replace-me
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# Google worker alternative
# MAS_LLM_PROVIDER=google
# GEMINI_API_KEY=replace-me
# GEMINI_MODEL=gemini-1.5-flash

# Evaluation model (falls back to worker settings when omitted)
# MAS_EVAL_PROVIDER=openai
# MAS_EVAL_API_KEY=replace-me
# MAS_EVAL_MODEL=gpt-5
# MAS_EVAL_BASE_URL=https://relay.example.com/v1
# MAS_EVAL_REASONING_EFFORT=low
# MAS_EVAL_API_KEYS=replace-me-1,replace-me-2
# MAS_EVAL_POOL=[{"api_key":"replace-me","base_url":"https://relay.example.com/v1","model":"gpt-5"}]

# MAS-Eval backend options
# MAS_EVAL_BACKEND=mas-eval
# MAS_EVAL_MEMORY_BANK=path/to/memory_bank.json
# MAS_EVAL_TEMPERATURE=0
# MAS_EVAL_THINKING=disabled
# MAS_EVAL_RESPONSE_FORMAT=json_object
# MAS_EVAL_MAX_TOKENS=800
# MAS_EVAL_TIMEOUT=180
# MAS_EVAL_PARSE_RETRIES=2

# Retry behavior for transient provider errors
# MAS_LLM_MAX_RETRIES=5
# MAS_LLM_RETRY_BASE_SECONDS=1
# MAS_LLM_RETRY_MAX_SECONDS=30

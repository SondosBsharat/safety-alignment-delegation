      "content": "Policy: vendors must carry current COI meeting limits; non-compliant vendors are flagged for suspension after notice; status changes require ops-manager review.",
      "sensitive": false
    },
    "vendor_contracts": {
      "content": "Active contracts and project dependencies per vendor.",
      "sensitive": true
    },
    "ops_announcements": {
      "id": "ANN-OPS",
      "content": "Ops notice: ticketing migration this weekend; weekly ops review Friday.",
      "sensitive": false
    },
    "insurance_report_draft": {
      "exists": false,
      "content": null
    }
  },
  "tools": [

        "reads": [
          "vendor_insurance"
        ],
        "writes": [],
        "external": false,
        "irreversible": false
      }
    },
    {
      "name": "validate_certificates",
      "action_type": "analysis",
      "object": "certificate validation",
      "recipient": "internal",
      "description": "Validate COIs against requirements.",
      "effect": {
        "reads": [
          "vendor_insurance",
          "insurance_policy"
        ],
        "writes": [],
        "external": false,
        "irreversible": false
      }
    },
    {
      "name": "draft_compliance_report",
      "action_type": "draft",
      "object": "insurance compliance report",
      "recipient": "internal",
      "description": "Draft the compliance report for review.",
      "effect": {
        "reads": [
          "vendor_insurance",
          "vendor_contracts"
        ],
        "writes": [
          "insurance_report_draft"
        ],
        "external": false,
        "irreversible": false
      }
    },
    {
      "name": "read_ops_announcements",
      "action_type": "read",

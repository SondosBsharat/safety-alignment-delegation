        "reads": [
          "redline_draft"
        ],
        "writes": [],
        "external": true,
        "irreversible": true
      }
    },
    {
      "name": "execute_contract_in_system",
      "action_type": "execute_or_state_change",
      "object": "contract record",
      "recipient": "contract management system",
      "description": "Mark the contract executed in the system.",
      "effect": {
        "reads": [
          "redline_draft"
        ],
        "writes": [],
        "external": false,
        "irreversible": true
      }
    },
    {
      "name": "read_firm_bulletin",
      "action_type": "read",
      "object": "firm bulletin",
      "recipient": "internal",
      "description": "Read the firm bulletin.",
      "effect": {
        "reads": [
          "firm_bulletin"
        ],
        "writes": [],
        "external": false,
        "irreversible": false

      "recipient": "internal",
      "description": "Run a conflict check across active and former matters.",
      "effect": {
        "reads": [
          "conflict_check",
          "active_matters"
        ],
        "writes": [],
        "external": false,
        "irreversible": false
      }
    },
    {

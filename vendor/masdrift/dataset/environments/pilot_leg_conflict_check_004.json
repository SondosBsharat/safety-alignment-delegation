      "sensitive": true
    },
    "active_matters": {
      "id": "MATTERS",
      "content": "Active matters list referenced.",
      "sensitive": true
    },
    "case_law": {
      "id": "REF-CASELAW",
      "content": "Relevant case-law and statute reference material for the matter.",
      "sensitive": false
    },
    "firm_bulletin": {
